              "code": "/**\n * Rounds the edges of a solid, like the molded fillets on the original\n * Maslow adapters. Edges are left sharp where they meet the base (below\n * `aboveZ`), at the hose socket mouth (reaching back past `keepY`, so the\n * hose still fits) and along the front face (y = 0), where the front wall\n * is only 4 mm tall.\n *\n * OpenCascade can't round every combination of edges at every hose size,\n * so edges are added one at a time, each with the largest radius (from\n * `radius` down to a fifth of it) that still rounds along with the edges\n * chosen so far. A fillet only counts if the result is a valid solid and\n * adds no sliver faces narrower than `minFace`; OpenCascade sometimes\n * returns broken geometry instead of failing. Edges that can't be rounded\n * stay sharp and are listed in the console.\n */\nfunction run(\n  shape: Assembly,\n  radius: number = 2.5,\n  aboveZ: number = 2.5,\n  keepY: number = -99,\n  minFace: number = 0.25,\n): Assembly {\n  const oc = replicad.getOC();\n  const wanted = (edge) => {\n    const [[, y0, z0], [, y1]] = edge.boundingBox.bounds;\n    return z0 > aboveZ && y0 > keepY && y1 < -0.5;\n  };\n  const describe = (edge) =>\n    edge.boundingBox.bounds\n      .map((p) => p.map((v) => v.toFixed(1)).join(\", \"))\n      .join(\" to \");\n  const radii = [1, 0.6, 0.4, 0.2].map((f) => radius * f);\n\n  const isValid = (s) => {\n    const check = new oc.BRepCheck_Analyzer(s.wrapped, true, false);\n    const ok = check.IsValid();\n    check.delete();\n    return ok;\n  };\n  // A face's width is roughly 2 * area / perimeter (exact for a thin strip).\n  const slivers = (s) =>\n    s.faces.filter((f) => {\n      const area = replicad.measureArea(f);\n      const perimeter = f.edges.reduce(\n        (sum, e) => sum + replicad.measureLength(e),\n        0,\n      );\n      return (2 * area) / perimeter < minFace;\n    }).length;\n\n  return new Assembly(shape).onLeafs((leaf) => {\n    const solid = leaf.geometry;\n    const allowedSlivers = slivers(solid);\n    const chosen: { edge: any; r: number }[] = [];\n    let rounded = solid;\n    let smaller = 0;\n    for (const edge of solid.edges) {\n      if (!wanted(edge)) continue;\n      let done = false;\n      for (const r of radii) {\n        const trial = [...chosen, { edge, r }];\n        try {\n          const result = solid.clone().fillet((e) => {\n            const hit = trial.find((t) => t.edge.isSame(e));\n            return hit ? hit.r : null;\n          });\n          if (!isValid(result) || slivers(result) > allowedSlivers) continue;\n          rounded = result;\n          chosen.push({ edge, r });\n          if (r < radius) smaller++;\n          done = true;\n          break;\n        } catch (err) {\n          // try a smaller radius\n        }\n      }\n      if (!done) console.log(`Left sharp: edge from ${describe(edge)}`);\n    }\n    console.log(\n      `Rounded ${chosen.length} edges (${smaller} with a smaller radius)`,\n    );\n    leaf.geometry = rounded;\n    return leaf;\n  });\n}\n",
              "compiledCode": "\"use strict\";\n/**\n * Rounds the edges of a solid, like the molded fillets on the original\n * Maslow adapters. Edges are left sharp where they meet the base (below\n * `aboveZ`), at the hose socket mouth (reaching back past `keepY`, so the\n * hose still fits) and along the front face (y = 0), where the front wall\n * is only 4 mm tall.\n *\n * OpenCascade can't round every combination of edges at every hose size,\n * so edges are added one at a time, each with the largest radius (from\n * `radius` down to a fifth of it) that still rounds along with the edges\n * chosen so far. A fillet only counts if the result is a valid solid and\n * adds no sliver faces narrower than `minFace`; OpenCascade sometimes\n * returns broken geometry instead of failing. Edges that can't be rounded\n * stay sharp and are listed in the console.\n */\nfunction run(shape, radius = 2.5, aboveZ = 2.5, keepY = -99, minFace = 0.25) {\n    const oc = replicad.getOC();\n    const wanted = (edge) => {\n        const [[, y0, z0], [, y1]] = edge.boundingBox.bounds;\n        return z0 > aboveZ && y0 > keepY && y1 < -0.5;\n    };\n    const describe = (edge) => edge.boundingBox.bounds\n        .map((p) => p.map((v) => v.toFixed(1)).join(\", \"))\n        .join(\" to \");\n    const radii = [1, 0.6, 0.4, 0.2].map((f) => radius * f);\n    const isValid = (s) => {\n        const check = new oc.BRepCheck_Analyzer(s.wrapped, true, false);\n        const ok = check.IsValid();\n        check.delete();\n        return ok;\n    };\n    // A face's width is roughly 2 * area / perimeter (exact for a thin strip).\n    const slivers = (s) => s.faces.filter((f) => {\n        const area = replicad.measureArea(f);\n        const perimeter = f.edges.reduce((sum, e) => sum + replicad.measureLength(e), 0);\n        return (2 * area) / perimeter < minFace;\n    }).length;\n    return new Assembly(shape).onLeafs((leaf) => {\n        const solid = leaf.geometry;\n        const allowedSlivers = slivers(solid);\n        const chosen = [];\n        let rounded = solid;\n        let smaller = 0;\n        for (const edge of solid.edges) {\n            if (!wanted(edge))\n                continue;\n            let done = false;\n            for (const r of radii) {\n                const trial = [...chosen, { edge, r }];\n                try {\n                    const result = solid.clone().fillet((e) => {\n                        const hit = trial.find((t) => t.edge.isSame(e));\n                        return hit ? hit.r : null;\n                    });\n                    if (!isValid(result) || slivers(result) > allowedSlivers)\n                        continue;\n                    rounded = result;\n                    chosen.push({ edge, r });\n                    if (r < radius)\n                        smaller++;\n                    done = true;\n                    break;\n                }\n                catch (err) {\n                    // try a smaller radius\n                }\n            }\n            if (!done)\n                console.log(`Left sharp: edge from ${describe(edge)}`);\n        }\n        console.log(`Rounded ${chosen.length} edges (${smaller} with a smaller radius)`);\n        leaf.geometry = rounded;\n        return leaf;\n    });\n}\n"
            }
          ],
