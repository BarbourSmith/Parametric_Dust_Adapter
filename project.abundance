            {
              "atomType": "Code",
              "x": 0.4,
              "y": 0.5,
              "uniqueID": "id-236",
              "interpreterVersion": 1,
              "code": "/**\n * The open underside of the dust hose adapter: the area inside its 2 mm\n * walls that faces the sled. Traced from the bottom face of the Maslow4\n * adapter STEP files.\n */\nfunction run(): Assembly {\n  const opening = replicad\n    .draw([31.36, -4.37])\n    .lineTo([70.13, -4.37]) // inside of the front wall\n    .threePointsArcTo([74.46, -21.63], [75.51, -14.5]) // rounded corner\n    .threePointsArcTo([-74.46, -21.63], [0, -77.54]) // inside of outer wall r77.54\n    .threePointsArcTo([-70.13, -4.37], [-75.51, -14.5]) // rounded corner\n    .lineTo([-31.36, -4.37])\n    .threePointsArcTo([-30.78, -6.76], [-30.67, -5.7]) // small corner\n    .threePointsArcTo([30.78, -6.76], [0, -44.41]) // outside of router wall r31.41\n    .threePointsArcTo([31.36, -4.37], [30.67, -5.7]) // small corner\n    .close();\n  return new Assembly({ geometry: opening });\n}\n",
              "compiledCode": "\"use strict\";\n/**\n * The open underside of the dust hose adapter: the area inside its 2 mm\n * walls that faces the sled. Traced from the bottom face of the Maslow4\n * adapter STEP files.\n */\nfunction run() {\n    const opening = replicad\n        .draw([31.36, -4.37])\n        .lineTo([70.13, -4.37]) // inside of the front wall\n        .threePointsArcTo([74.46, -21.63], [75.51, -14.5]) // rounded corner\n        .threePointsArcTo([-74.46, -21.63], [0, -77.54]) // inside of outer wall r77.54\n        .threePointsArcTo([-70.13, -4.37], [-75.51, -14.5]) // rounded corner\n        .lineTo([-31.36, -4.37])\n        .threePointsArcTo([-30.78, -6.76], [-30.67, -5.7]) // small corner\n        .threePointsArcTo([30.78, -6.76], [0, -44.41]) // outside of router wall r31.41\n        .threePointsArcTo([31.36, -4.37], [30.67, -5.7]) // small corner\n        .close();\n    return new Assembly({ geometry: opening });\n}\n"
            }
